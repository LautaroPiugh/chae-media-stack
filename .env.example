# ============================================================
#  CHAE MEDIA STACK — configuración
#  Copiar a .env y ajustar antes de ./install.sh o start-stack.sh
# ============================================================

# IP LAN donde se publican los puertos (ip del server)
MEDIA_SERVER_IP=192.168.0.200

# Raíz de la biblioteca y de descargas
MEDIA_ROOT=/mnt/media
DOWNLOADS_ROOT=/mnt/media2/downloads

# Zona horaria y usuario dueño de los archivos
TZ=Etc/UTC
PUID=1000
PGID=1000
