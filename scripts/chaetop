ENV = None


def load_env(path):
    env = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return env


def local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "127.0.0.1"


def human_bytes(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "-"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024:
            if unit == "B":
                return f"{n:.0f} B"
            return f"{n:.1f} {unit}" if n < 10 else f"{n:.0f} {unit}"
        n /= 1024
    return f"{n:.1f} PiB"


def api_get(url, headers=None, timeout=6):
    try:
        req = urllib.request.Request(url)
        for k, v in (headers or {}).items():
            req.add_header(k, v)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode(errors="replace"))
    except Exception:
        return None


DOCKER = shutil.which("docker") or "/usr/bin/docker"
if not os.path.exists(DOCKER):
    for p in ("/usr/bin/docker", "/usr/local/bin/docker", "/snap/bin/docker"):
        if os.path.exists(p):
            DOCKER = p
            break


def parse_docker_ps(out):
    svcs = []
    for line in out.splitlines():
        parts = line.split("|")
        if len(parts) == 3:
            svcs.append({"name": parts[0], "status": parts[1], "state": parts[2]})
    return svcs


def docker_collect():
    while True:
        try:
            out = subprocess.run(
                [DOCKER, "ps", "--format", "{{.Names}}|{{.Status}}|{{.State}}"],
                capture_output=True, text=True, timeout=15,
            ).stdout
            with LOCK:
                SNAP["services"] = parse_docker_ps(out)
                SNAP["docker_err"] = ""
        except Exception as e:
            with LOCK:
                SNAP["docker_err"] = str(e)
        try:
            time.sleep(5)
        except Exception:
            time.sleep(5)


def stats_collect():
    fmt = "{{.Name}}|{{.CPUPerc}}|{{.MemUsage}}|{{.MemPerc}}"
    while True:
        try:
            out = subprocess.run(
                [DOCKER, "stats", "--no-stream", "--format", fmt],
                capture_output=True, text=True, timeout=30,
            ).stdout
            st = {}
            for line in out.splitlines():
                parts = line.split("|")
                if len(parts) == 4:
                    st[parts[0]] = (
                        parts[1].strip().rstrip("%"),
                        parts[2].strip(),
                        parts[3].strip().rstrip("%"),
                    )
            with LOCK:
                SNAP["stats"] = st
        except Exception:
            pass
        time.sleep(6)


class Qbit:
    def __init__(self):
        global ENV
        self.user = ENV.get("QBIT_USER", "")
        self.pw = ENV.get("QBIT_PASS", "")
        self.cookie = ""
        self.logged = False

    def _req(self, path, data=None):
        req = urllib.request.Request(QBIT_URL + path)
        req.add_header("Origin", QBIT_URL)
        req.add_header("Referer", QBIT_URL + "/")
        if self.cookie:
            req.add_header("Cookie", self.cookie)
        body = urllib.parse.urlencode(data).encode() if data else None
        with urllib.request.urlopen(req, data=body, timeout=5) as r:
            return r.read().decode(errors="replace"), r.headers.get("Set-Cookie", "")

    def login(self):
        if self.user:
            out, hdr = self._req("/api/v2/auth/login", {"username": self.user, "password": self.pw})
            m = re.search(r"([A-Za-z0-9_]*SID[A-Za-z0-9_]*)=([^;]+)", hdr)
            if m:
                self.cookie = f"{m.group(1)}={m.group(2)}"
                return True
            return False
        try:
            out, _ = self._req("/api/v2/app/version")
            return "v" in out
        except Exception:
            return False


def qbit_collect():
    q = Qbit()
    while True:
        try:
            if not q.logged:
                q.logged = q.login()
            if not q.logged:
                with LOCK:
                    SNAP["qbit"] = None
                    if not q.user:
                        SNAP["qbit_err"] = "sin credenciales (~/.config/chaetop/chaetop.env)"
                    else:
                        SNAP["qbit_err"] = "login fallido (revisar credenciales)"
                time.sleep(10)
                continue
            tjson, _ = q._req("/api/v2/transfer/info")
            tr = json.loads(tjson)
            trjson, _ = q._req("/api/v2/torrents/info?limit=12&sort=dlspeed&reverse=true")
            ts = json.loads(trjson)
            active = [t for t in ts if t.get("dlspeed", 0) > 0 or t.get("upspeed", 0) > 0 or t.get("progress", 1) < 1]
            active = active[:6]
            with LOCK:
                SNAP["qbit"] = {"transfer": tr, "torrents": active}
                SNAP["qbit_err"] = ""
        except Exception as e:
            with LOCK:
                SNAP["qbit"] = None
                SNAP["qbit_err"] = f"error: {e}"
            q.logged = False
            q.cookie = ""
            time.sleep(8)
            continue
        time.sleep(3)


def mount_health(path, uuid):
    if not os.path.isdir(path):
        return "no existe"
    if not os.path.exists(f"/dev/disk/by-uuid/{uuid}"):
        return "disco ausente"
    if subprocess.run(["mountpoint", "-q", path]).returncode != 0:
        return "sin montar"
    cur = ""
    try:
        cur = subprocess.run(
            ["findmnt", "-rn", "-o", "UUID", "--target", path],
            capture_output=True, text=True,
        ).stdout.strip()
    except Exception:
        pass
    if cur != uuid:
        return "disco equivocado"
    opts = ""
    try:
        opts = subprocess.run(
            ["findmnt", "-rn", "-o", "OPTIONS", "--target", path],
            capture_output=True, text=True,
        ).stdout.strip()
    except Exception:
        pass
    if opts and "rw" not in opts.split(","):
        return "read-only!"
    return "ok"


def disk_collect():
    while True:
        disks = []
        seen = {}
        try:
            with open("/proc/mounts") as f:
                for line in f:
                    parts = line.split()
                    if len(parts) < 3:
                        continue
                    dev, mp, fstype = parts[0], parts[1], parts[2]
                    if fstype not in REAL_FS:
                        continue
                    if mp == "/" or any(mp.startswith(p + "/") or mp == p for p in SKIP_MOUNTS):
                        if mp != "/":
                            continue
                    seen[mp] = {"dev": dev, "fstype": fstype}
        except OSError:
            pass

        for mp in sorted(seen, key=lambda p: (p != "/", p)):
            info = seen[mp]
            try:
                st = os.statvfs(mp)
                total = st.f_blocks * st.f_frsize
                free = st.f_bavail * st.f_frsize
                used = total - st.f_bfree * st.f_frsize
                pct = (used / total * 100) if total else 0
            except OSError:
                continue
            if total < 4 * 1024 ** 3:
                continue
            if info["dev"].startswith("/dev/"):
                dev = os.path.basename(info["dev"])[:12]
            elif "mergerfs" in info["fstype"]:
                dev = "pool"
            else:
                dev = info["fstype"]
            disk = {
                "path": mp,
                "dev": dev,
                "fstype": info["fstype"],
                "total": total,
                "used": used,
                "free": free,
                "pct": pct,
                "health": "",
            }
            if mp in BRANCH_UUID_BY_PATH:
                disk["health"] = mount_health(mp, BRANCH_UUID_BY_PATH[mp])
            disks.append(disk)

        with LOCK:
            SNAP["disks"] = disks
        time.sleep(10)


def media_collect():
    global ENV
    while True:
        media = {}
        env = ENV or {}
        try:
            jf_key = env.get("JELLYFIN_KEY", "")
            if jf_key:
                hdr = {"Authorization": f'MediaBrowser Token="{jf_key}"'}
                counts = api_get("http://127.0.0.1:8096/Items/Counts", hdr) or {}
                if counts:
                    media["jf_lib"] = (f"{counts.get('MovieCount', 0)} pelis · "
                                       f"{counts.get('SeriesCount', 0)} series · "
                                       f"{counts.get('EpisodeCount', 0)} eps")
                sessions = api_get("http://127.0.0.1:8096/Sessions", hdr) or []
                playing = [s for s in sessions if isinstance(s, dict) and s.get("NowPlayingItem")]
                media["jf_sessions"] = [
                    f"{s.get('UserName', '?')} · {(s.get('NowPlayingItem') or {}).get('Name', '?')}"
                    for s in playing[:3]
                ]

            rk = env.get("RADARR_KEY", "")
            if rk:
                hdr = {"X-Api-Key": rk}
                movies = api_get("http://127.0.0.1:7878/api/v3/movie", hdr)
                if isinstance(movies, list):
                    total = len(movies)
                    have = sum(1 for m in movies if isinstance(m, dict) and m.get("hasFile"))
                    q = api_get("http://127.0.0.1:7878/api/v3/queue?pageSize=1", hdr) or {}
                    media["radarr"] = (total, total - have, q.get("totalRecords", 0))

            sk = env.get("SONARR_KEY", "")
            if sk:
                hdr = {"X-Api-Key": sk}
                series = api_get("http://127.0.0.1:8989/api/v3/series", hdr)
                if isinstance(series, list):
                    q = api_get("http://127.0.0.1:8989/api/v3/queue?pageSize=1", hdr) or {}
                    miss = api_get("http://127.0.0.1:8989/api/v3/wanted/missing?pageSize=1&includeMonitored=true", hdr) or {}
                    media["sonarr"] = (len(series), miss.get("totalRecords", 0), q.get("totalRecords", 0))

            sk2 = env.get("SEERR_KEY", "")
            if sk2:
                hdr = {"X-Api-Key": sk2}
                req = api_get("http://127.0.0.1:5055/api/v1/request?take=1&skip=0&filter=processing", hdr) or {}
                media["seerr"] = (req.get("pageInfo") or {}).get("results", 0)

            with LOCK:
                SNAP["media"] = media
                SNAP["media_err"] = ""
        except Exception as e:
            with LOCK:
                SNAP["media_err"] = f"error: {e}"
        time.sleep(20)


REPAIR_LOGS = [
    os.path.join(HOME, "stack", "logs", "repair-girls.log"),
    os.path.join(HOME, "stack", "logs", "repair-all.log"),
]


def repair_collect():
    while True:
        rep = {}
        try:
            log = ""
            for f in REPAIR_LOGS:
                if os.path.isfile(f) and os.path.getsize(f) > 0:
                    log = f
            for f in REPAIR_LOGS:
                try:
                    with open(f, errors="replace") as fh:
                        tail = fh.read()[-4000:]
                    if "whisper+traducir:" in tail and "reparados" not in tail.split("whisper+traducir:")[-1]:
                        log = f
                except OSError:
                    pass
            if log:
                try:
                    with open(log, errors="replace") as fh:
                        txt = fh.read()
                except OSError:
                    txt = ""
                ok = txt.count("-> OK")
                bad = sum(txt.count(s) for s in (
                    "no devolvio SRT", "no se pudo extraer",
                    "fallo la traduccion", "QA rechazo"))
                import re as _re
                m = _re.findall(r"\[(\d+)/(\d+)\]", txt)
                cur, total = (m[-1] if m else ("", ""))
                running = False
                try:
                    running = subprocess.run(
                        ["pgrep", "-f", "fix_subs_whisper.py fix-broken"],
                        capture_output=True, timeout=3).returncode == 0
                except Exception:
                    running = False
                cur_items = _re.findall(r"whisper\+traducir: (.+?) \(dur=", txt)
                last = ""
                for line in txt.splitlines():
                    if line.startswith("["):
                        last = line
                rep = {
                    "log": os.path.basename(log), "ok": ok, "bad": bad,
                    "cur": cur, "total": total, "running": running,
                    "item": cur_items[-1] if (running and cur_items) else "",
                    "last": last[:110],
                }
        except Exception as e:
            rep = {"err": str(e)[:60]}
        with LOCK:
            SNAP["repair"] = rep
        time.sleep(3)


def read_cpu():
    with open("/proc/stat") as f:
        line = f.readline()
    parts = [int(x) for x in line.split()[1:]]
    idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
    total = sum(parts)
    return idle, total


def read_mem():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":")
            info[k] = int(v.split()[0])
    kb = 1024.0
    total = info["MemTotal"] * kb
    used = (info["MemTotal"] - info["MemAvailable"]) * kb
    swap_t = info.get("SwapTotal", 0) * kb
    swap_u = (info.get("SwapTotal", 0) - info.get("SwapFree", 0)) * kb
    return total, used, swap_t, swap_u


def read_net():
    rx = tx = 0
    with open("/proc/net/dev") as f:
        for line in f.readlines()[2:]:
            if ":" not in line:
                continue
            iface, data = line.split(":", 1)
            if iface.strip() in ("lo",) or iface.strip().startswith(("docker", "veth", "br-")):
                continue
            f2 = data.split()
            rx += int(f2[0])
            tx += int(f2[8])
    return rx, tx


def read_temps():
    temps = []
    base = "/sys/class/thermal"
    try:
        for z in sorted(os.listdir(base)):
            try:
                with open(os.path.join(base, z, "temp")) as f:
                    t = int(f.read().strip()) / 1000
                if 0 < t < 120:
                    temps.append(t)
            except OSError:
                pass
    except OSError:
        pass
    return temps


def clip(s, n):
    s = str(s)
    if n <= 0:
        return ""
    if len(s) <= n:
        return s
    return s[:max(0, n - 1)] + "…"


def bar(w, pct, char="█", empty="░"):
    n = max(0, min(int(w * pct / 100), w))
    return char * n + empty * (w - n)


class Chaetop:
    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.sel = 0
        self.last_cpu = read_cpu()
        self.last_net = (time.time(), *read_net())
        self.colors()

    def colors(self):
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_RED, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_YELLOW, -1)
        curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)
        curses.init_pair(6, curses.COLOR_WHITE, -1)
        self.R = curses.color_pair(1)
        self.G = curses.color_pair(2)
        self.Y = curses.color_pair(3)
        self.C = curses.color_pair(4)
        self.M = curses.color_pair(5)
        self.W = curses.color_pair(6)
        self.D = curses.A_DIM

    def safe(self, y, x, text, attr=0, w=None):
        try:
            H, W = self.stdscr.getmaxyx()
            y = max(0, y)
            x = max(0, x)
            if y >= H or x >= W:
                return
            n = (W - x) if w is None else min(w, W - x)
            if y == H - 1:
                n = min(n, W - x - 1)
            if n <= 0:
                return
            self.stdscr.addnstr(y, x, str(text), n, attr)
        except curses.error:
            pass

    def pct_color(self, p, hi=90, mid=70):
        if p >= hi:
            return self.R
        if p >= mid:
            return self.Y
        return self.G

    def gauge(self, y, x, w, label, pct, extra="", extra_max=None):
        col = self.pct_color(pct)
        self.safe(y, x, f"{label:<7}", self.C)
        self.safe(y, x + 7, bar(w, pct), col)
        tail = f" {pct:4.1f}% {extra}".rstrip()
        if extra_max is not None:
            _, W = self.stdscr.getmaxyx()
            room = min(extra_max, W - (x + 7 + w))
            if room <= 0:
                return
            self.safe(y, x + 7 + w, tail, self.D, room)
        else:
            self.safe(y, x + 7 + w, tail, self.D)

    def draw_disks(self, y, H, W):
        self.safe(y, 0, "DISCOS Y MOUNTS", self.M | curses.A_BOLD)
        self.safe(y, 26, "auto · se agregan solos al montar", self.D)
        y += 1
        with LOCK:
            disks = list(SNAP["disks"])
        if not disks:
            self.safe(y, 2, "cargando…", self.D)
            return y + 2
        # columnas fijas: label(12) barra(bw) pct(7) used/total(23) libre(18) meta(22) health(6)
        bw = max(12, min(46, W - 98))
        col_lbl, col_bar = 0, 13
        col_pct = col_bar + bw
        col_sz = col_pct + 7
        col_free = col_sz + 24
        col_meta = col_free + 19
        for d in disks:
            if y >= H - 3:
                break
            label = d["path"] if d["path"] == "/" else os.path.basename(d["path"].rstrip("/")) or d["path"]
            self.safe(y, col_lbl, f"{label[:12]:<12}", self.C)
            self.safe(y, col_bar, bar(bw, d["pct"]), self.pct_color(d["pct"], 90, 80))
            self.safe(y, col_pct, f"{d['pct']:5.1f}% ", self.D, 7)
            self.safe(y, col_sz, f"{human_bytes(d['used'])} / {human_bytes(d['total'])}", self.D, 23)
            self.safe(y, col_free, f"libre {human_bytes(d['free'])}", self.G if d["pct"] < 90 else self.Y, 18)
            meta = f"{d['dev']} · {d['fstype']}"
            self.safe(y, col_meta, clip(meta, max(0, W - col_meta - 10)), self.D, max(0, W - col_meta - 10))
            if d["health"]:
                col = self.G if d["health"] == "ok" else self.R
                self.safe(y, W - 8, f"[{d['health']}]", col)
            y += 1
        return y + 1

    def draw_media(self, y, H, W):
        with LOCK:
            media = dict(SNAP["media"])
            merr = SNAP["media_err"]
        if merr and not media:
            self.safe(y, 2, f"MEDIA STACK · {merr}", self.D, max(0, W - 4))
            return y + 1
        if not media:
            return y
        if y > H - 5:
            return y
        self.safe(y, 0, "MEDIA STACK", self.M | curses.A_BOLD)
        y += 1
        x2 = max(48, W // 2)
        rad = media.get("radarr") or (0, 0, 0)
        son = media.get("sonarr") or (0, 0, 0)
        self.safe(y, 0, "🎬 Jellyfin", self.Y)
        self.safe(y, 12, clip(media.get("jf_lib") or "-", max(0, x2 - 14)), self.D, max(0, x2 - 14))
        self.safe(y, x2, "🍿 Radarr", self.Y)
        self.safe(y, x2 + 12, clip(f"{rad[0]} pelis · faltan {rad[1]} · cola {rad[2]}", max(0, W - x2 - 13)),
                  self.D, max(0, W - x2 - 13))
        y += 1
        sessions = media.get("jf_sessions") or []
        if sessions:
            for s in sessions[:1]:
                self.safe(y, 12, clip(f"▶ {s}", max(0, x2 - 14)), self.G, max(0, x2 - 14))
        else:
            self.safe(y, 12, "sin reproducción activa", self.D, max(0, x2 - 14))
        self.safe(y, x2, "📺 Sonarr", self.Y)
        self.safe(y, x2 + 12, clip(f"{son[0]} series · {son[1]} eps faltan · cola {son[2]}", max(0, W - x2 - 13)),
                  self.D, max(0, W - x2 - 13))
        y += 1
        if len(sessions) > 1:
            for s in sessions[1:3]:
                self.safe(y, 12, clip(f"▶ {s}", max(0, x2 - 14)), self.G, max(0, x2 - 14))
                y += 1
        if media.get("seerr") is not None:
            self.safe(y, x2, "🎟 Seerr", self.Y)
            self.safe(y, x2 + 12, f"{media['seerr']} pedidos en proceso", self.D)
            y += 1
        return y + 1

    def draw_repair(self, y, H, W):
        with LOCK:
            rep = dict(SNAP["repair"])
        if not rep:
            return y
        ok = int(rep.get("ok") or 0)
        bad = int(rep.get("bad") or 0)
        done = ok + bad
        if not rep.get("running") and done == 0:
            return y
        if y > H - 4:
            return y
        self.safe(y, 0, "SRT REPAIR", self.M | curses.A_BOLD)
        total = str(rep.get("total") or "")
        gw = max(10, min(24, W - 78))
        col = 12
        if total.isdigit() and int(total) > 0:
            pct = done * 100.0 / int(total)
            self.safe(y, col, bar(gw, pct), self.pct_color(pct, hi=95, mid=80))
            col += gw + 1
            self.safe(y, col, f"{pct:4.0f}%", self.C, 5)
            col += 6
            self.safe(y, col, f"{done}/{total}", self.W, 8)
            col += 8
        else:
            self.safe(y, col, f"{done} procesados", self.C, 14)
            col += 15
        self.safe(y, col, f"✓{ok}", self.G, 6)
        col += 6
        self.safe(y, col, f"✗{bad}", self.R if bad else self.D, 6)
        col += 7
        if rep.get("running"):
            self.safe(y, col, "EN CURSO", self.G | curses.A_BOLD, 10)
        else:
            self.safe(y, col, "DETENIDO", self.Y | curses.A_BOLD, 10)
        y += 1
        item = str(rep.get("item") or "")
        if item and y <= H - 3:
            self.safe(y, 12, clip(f"▶ {item}", max(0, W - 14)), self.W, max(0, W - 14))
            y += 1
        return y

    def draw(self):
        stdscr = self.stdscr
        stdscr.erase()
        H, W = stdscr.getmaxyx()
        now = time.time()

        with open("/proc/uptime") as f:
            up = int(float(f.read().split()[0]))
        up_s = f"{up // 86400}d {up % 86400 // 3600}h {up % 3600 // 60}m"
        load1, load5, load15 = os.getloadavg()

        cpu_idle, cpu_total = self.last_cpu
        idle, total = read_cpu()
        d_total = total - cpu_total
        d_idle = idle - cpu_idle
        cpu_pct = (1 - d_idle / d_total) * 100 if d_total > 0 else 0
        self.last_cpu = (idle, total)

        mem_t, mem_u, swap_t, swap_u = read_mem()
        mem_pct = mem_u / mem_t * 100 if mem_t else 0

        t_now, rx, tx = self.last_net
        rx2, tx2 = read_net()
        dt = now - t_now
        rx_s = (rx2 - rx) / dt if dt > 0 else 0
        tx_s = (tx2 - tx) / dt if dt > 0 else 0
        self.last_net = (now, rx2, tx2)

        temps = read_temps()

        with LOCK:
            services = list(SNAP["services"])
            stats = dict(SNAP["stats"])
            qbit = SNAP["qbit"]
            qbit_err = SNAP["qbit_err"]
            docker_err = SNAP["docker_err"]
            repair = dict(SNAP["repair"])

        stamp = time.strftime("%a %d/%m %H:%M:%S")
        left = f"◆ chaetop   {HOSTNAME} · {local_ip()}"
        mid = f"up {up_s}   load {load1:.2f} {load5:.2f} {load15:.2f}"
        if temps:
            mid += f"   {max(temps):.0f}°C"
        mid_x = min(len(left) + 2, max(0, W - 18 - len(mid) - 2))
        self.safe(0, 0, clip(left, max(0, mid_x - 1)), self.M | curses.A_BOLD, mid_x)
        self.safe(0, mid_x, clip(mid, max(0, W - 18 - mid_x)), self.D, max(0, W - 18 - mid_x))
        self.safe(0, W - 18, stamp, self.C, 18)
        self.safe(1, 0, "─" * (W - 1), self.D)

        y = 2
        NET_W = 30
        gw = max(12, W - 78)
        extra_max = max(10, W - 43 - gw)
        self.gauge(y, 0, gw, "CPU", cpu_pct, f"{os.cpu_count()} núcleos", extra_max)
        self.safe(y, W - NET_W, f"▼ {human_bytes(rx_s)}/s  ▲ {human_bytes(tx_s)}/s", self.Y, NET_W)
        y += 1
        self.gauge(y, 0, gw, "RAM", mem_pct, f"{human_bytes(mem_u)} / {human_bytes(mem_t)}", extra_max)
        y += 1
        if swap_t:
            self.gauge(y, 0, gw, "SWAP", swap_u / swap_t * 100,
                       f"{human_bytes(swap_u)} / {human_bytes(swap_t)}", extra_max)
            y += 1

        y += 1
        if repair.get("running") or (int(repair.get("ok") or 0) + int(repair.get("bad") or 0)) > 0:
            y = self.draw_repair(y, H, W)
            y += 1

        y = self.draw_disks(y, H, W)

        y = self.draw_media(y, H, W)

        if qbit and (W >= 90 and H >= 22):
            self.safe(y, 0, "TORRENTS (qBittorrent)", self.M | curses.A_BOLD)
            tr = qbit["transfer"]
            dl = tr.get("dl_info_speed", 0)
            ul = tr.get("up_info_speed", 0)
            self.safe(y, 26, f"▼ {human_bytes(dl)}/s   ▲ {human_bytes(ul)}/s", self.Y)
            y += 1
            if not qbit["torrents"]:
                self.safe(y, 2, "sin actividad", self.D)
                y += 1
            for t in qbit["torrents"]:
                if y >= H - 3:
                    break
                name_w = max(16, W - 48)
                self.safe(y, 2, t.get("name", "?"), self.W, name_w)
                self.safe(y, 2 + name_w, bar(16, t.get("progress", 0) * 100), self.C)
                self.safe(y, 19 + name_w, f"{t.get('progress', 0) * 100:5.1f}%", self.D, 6)
                self.safe(y, 26 + name_w,
                          f"▼{human_bytes(t.get('dlspeed', 0))}/s  ETA {fmt_eta(t.get('eta', -1))}",
                          self.D)
                y += 1
            y += 1
        elif qbit_err and (W >= 90 and H >= 22):
            self.safe(y, 0, "TORRENTS (qBittorrent)", self.M | curses.A_BOLD)
            self.safe(y, 26, qbit_err, self.R)
            y += 2

        if docker_err:
            self.safe(y, 0, f"docker error: {docker_err}", self.R)
            y += 2

        rows = max(0, H - y - 2)
        # columnas fijas compartidas por cabecera y filas
        C_NAME, C_EST, C_SAL, C_CPU, C_MEM, C_MEMPC, C_PTO, C_URL = 0, 26, 37, 48, 55, 67, 74, 82
        if rows > 0 and y <= H - 4:
            self.safe(y, 0, "SERVICIOS DOCKER", self.M | curses.A_BOLD)
            self.safe(y, C_EST, f"{'ESTADO':<10}", self.D)
            self.safe(y, C_SAL, f"{'SALUD':<10}", self.D)
            self.safe(y, C_CPU, f"{'CPU%':>6}", self.D)
            self.safe(y, C_MEM, f"{'MEM':>11}", self.D)
            self.safe(y, C_MEMPC, f"{'MEM%':>6}", self.D)
            self.safe(y, C_PTO, f"{'PUERTO':>6}", self.D)
            if W > C_URL:
                self.safe(y, C_URL, "URL", self.D)
            y += 1

        services.sort(key=lambda s: (s["name"] not in CORE, s["name"]))
        services = services[:max(0, rows - 1)]
        if not services and rows > 0 and y <= H - 3:
            self.safe(y, 2, "cargando…", self.D)
        for i, s in enumerate(services):
            if y + i > H - 3:
                break
            st = stats.get(s["name"], ("-", "-", "-"))
            sel = i == self.sel
            attr_sel = curses.A_REVERSE if sel else 0
            up = "running" in s["state"] or s["state"] == "running"
            st_mark = self.G if up else self.R
            h_mark = self.G if "healthy" in s["status"] else (self.Y if "health" in s["status"] else self.D)
            core_m = self.M if s["name"] in CORE else self.D
            self.safe(y + i, C_NAME, f"{'▶' if sel else ' '}{s['name'][:23]:<23}", attr_sel | core_m)
            self.safe(y + i, C_EST, f"{'● running' if up else '✗ caído':<10}", attr_sel | st_mark)
            self.safe(y + i, C_SAL, f"{health_txt(s['status']):<10}", attr_sel | h_mark)
            self.safe(y + i, C_CPU, f"{st[0]:>5}%", attr_sel)
            mem_u = (st[1] or "").split("/")[0].strip() or "-"
            self.safe(y + i, C_MEM, f"{mem_u:>11}", attr_sel)
            self.safe(y + i, C_MEMPC, f"{st[2]:>5}%", attr_sel)
            port = PORTS.get(s["name"], "")
            self.safe(y + i, C_PTO, f"{port if port else '—':>6}", attr_sel | (self.C if port else self.D))
            if port and W > C_URL + 8:
                self.safe(y + i, C_URL,
                          clip(f"http://127.0.0.1:{port}", max(0, W - C_URL)),
                          attr_sel | self.D, max(0, W - C_URL))

        self.safe(H - 2, 0, "─" * (W - 1), self.D)
        foot = " q salir · j/k servicio · l logs · r reiniciar · s shell · u updates · m mounts · d docker · ? ayuda "
        self.safe(H - 1, 0, clip(foot, W - 2), self.D, W - 2)

        self.sel = max(0, min(self.sel, len(services) - 1))
        stdscr.refresh()


def fmt_eta(s):
    if s in (8640000, -1):
        return "∞"
    s = int(s)
    if s >= 86400:
        return f"{s // 86400}d{s % 86400 // 3600}h"
    if s >= 3600:
        return f"{s // 3600}h{s % 3600 // 60}m"
    if s >= 60:
        return f"{s // 60}m{s % 60}s"
    return f"{s}s"


def health_txt(status):
    if "healthy" in status:
        return "healthy"
    if "unhealthy" in status:
        return "UNHEALTHY"
    if "health: starting" in status:
        return "starting"
    return "-"


def run_ext(stdscr, cmd, hint=""):
    curses.def_prog_mode()
    curses.endwin()
    code = 1
    try:
        code = subprocess.run(cmd).returncode
    except KeyboardInterrupt:
        pass
    except FileNotFoundError as e:
        print(f"chaetop: {e}")
    if hint:
        print(hint)
    print(f"\n[{code}] — Enter para volver a chaetop…")
    try:
        input()
    except KeyboardInterrupt:
        pass
    curses.reset_prog_mode()
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    curses.noecho()
    curses.cbreak()
    stdscr.keypad(True)
    stdscr.nodelay(True)
    stdscr.erase()
    stdscr.refresh()


def confirm(stdscr, text):
    H, W = stdscr.getmaxyx()
    win = curses.newwin(3, max(40, len(text) + 6), H // 2 - 1, max(0, W // 2 - len(text) // 2 - 3))
    win.box()
    win.addstr(1, 2, text, curses.color_pair(3) | curses.A_BOLD)
    win.refresh()
    stdscr.nodelay(False)
    k = win.getch()
    stdscr.nodelay(True)
    return k in (ord("y"), ord("Y"), curses.KEY_ENTER, 10)


def msg(stdscr, text):
    H, W = stdscr.getmaxyx()
    win = curses.newwin(3, max(40, len(text) + 6), H // 2 - 1, max(0, W // 2 - len(text) // 2 - 3))
    win.box()
    win.addstr(1, 2, text, curses.color_pair(4))
    win.refresh()
    stdscr.nodelay(False)
    win.getch()
    stdscr.nodelay(True)


def help_overlay(stdscr):
    H, W = stdscr.getmaxyx()
    lines = [
        "chaetop — dashboard del servidor chae",
        "",
        "  q / Esc      salir de chaetop",
        "  j / k / ↑↓   elegir servicio",
        "  l            logs en vivo del servicio (Ctrl+C para volver)",
        "  r            reiniciar el servicio (pide confirmación)",
        "  s            shell dentro del contenedor",
        "  u            preview de updates del stack (allowlist)",
        "  U            actualizar de verdad el servicio elegido",
        "  m            estado de mounts (scripts/media-status.sh)",
        "  d            docker ps detallado",
        "",
        "  Discos: se listan todos los montajes reales,",
        "  los que se agreguen aparecen solos.",
        "",
        "  qBittorrent: si no aparecen torrents, crea",
        "  ~/.config/chaetop/chaetop.env con QBIT_USER y QBIT_PASS",
        "",
        "  (cualquier tecla para cerrar)",
    ]
    w = min(W - 2, 66)
    win = curses.newwin(len(lines) + 2, w, max(0, H // 2 - len(lines) // 2), max(0, (W - w) // 2))
    win.box()
    for i, ln in enumerate(lines):
        win.addnstr(i + 1, 2, ln, w - 4, curses.A_BOLD if i == 0 else curses.A_NORMAL)
    win.refresh()
    stdscr.nodelay(False)
    win.getch()
    stdscr.nodelay(True)


def main(stdscr):
    global ENV
    ENV = load_env(ENV_PATH)
    threading.Thread(target=docker_collect, daemon=True).start()
    threading.Thread(target=stats_collect, daemon=True).start()
    threading.Thread(target=qbit_collect, daemon=True).start()
    threading.Thread(target=disk_collect, daemon=True).start()
    threading.Thread(target=media_collect, daemon=True).start()
    threading.Thread(target=repair_collect, daemon=True).start()

    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.keypad(True)
    app = Chaetop(stdscr)
    start = time.time()

    def read_keys():
        keys = []
        stdscr.nodelay(False)
        stdscr.timeout(400)
        k = stdscr.getch()
        if k != -1:
            keys.append(k)
            stdscr.nodelay(True)
            while True:
                k = stdscr.getch()
                if k == -1 or len(keys) >= 32:
                    break
                keys.append(k)
        stdscr.nodelay(True)
        return keys

    while True:
        with LOCK:
            no_services = not SNAP["services"] and not SNAP["docker_err"]
        if no_services and time.time() - start > 4:
            try:
                out = subprocess.run(
                    [DOCKER, "ps", "--format", "{{.Names}}|{{.Status}}|{{.State}}"],
                    capture_output=True, text=True, timeout=15,
                ).stdout
                with LOCK:
                    SNAP["services"] = parse_docker_ps(out)
            except Exception as e:
                with LOCK:
                    SNAP["docker_err"] = str(e)
            start = time.time()
        try:
            app.draw()
        except curses.error:
            pass
        for k in read_keys():
            if k in (ord("q"), ord("Q"), 27):
                return
            elif k in (ord("j"), curses.KEY_DOWN):
                app.sel += 1
            elif k in (ord("k"), curses.KEY_UP):
                app.sel = max(0, app.sel - 1)
            elif k in (ord("h"), ord("?")):
                help_overlay(stdscr)
            elif k in (ord("l"), ord("L")):
                with LOCK:
                    services = list(SNAP["services"])
                services.sort(key=lambda s: (s["name"] not in CORE, s["name"]))
                if services and app.sel < len(services):
                    ctr = services[app.sel]["name"]
                    run_ext(stdscr, [DOCKER, "logs", "-f", "--tail", "80", ctr],
                            hint="(Ctrl+C corta los logs)")
            elif k in (ord("r"), ord("R")):
                with LOCK:
                    services = list(SNAP["services"])
                services.sort(key=lambda s: (s["name"] not in CORE, s["name"]))
                if services and app.sel < len(services):
                    ctr = services[app.sel]["name"]
                    if confirm(stdscr, f"¿Reiniciar {ctr}? (y/n)"):
                        run_ext(stdscr, [DOCKER, "restart", ctr])
            elif k in (ord("s"), ord("S")):
                with LOCK:
                    services = list(SNAP["services"])
                services.sort(key=lambda s: (s["name"] not in CORE, s["name"]))
                if services and app.sel < len(services):
                    ctr = services[app.sel]["name"]
                    shell = "bash"
                    if subprocess.run([DOCKER, "exec", ctr, "which", "bash"],
                                      capture_output=True).returncode != 0:
                        shell = "sh"
                    run_ext(stdscr, [DOCKER, "exec", "-it", ctr, shell])
            elif k in (ord("u"), ord("U")):
                if k == ord("u"):
                    if confirm(stdscr, "¿Ver preview de updates del stack? (y/n)"):
                        run_ext(stdscr, [UPDATE_SCRIPT, "media"])
                else:
                    with LOCK:
                        services = list(SNAP["services"])
                    services.sort(key=lambda s: (s["name"] not in CORE, s["name"]))
                    if services and app.sel < len(services):
                        ctr = services[app.sel]["name"]
                        key = SERVICE_OF.get(ctr)
                        if not key:
                            msg(stdscr, f"{ctr} no es actualizable (sin compose o denylist)")
                        elif confirm(stdscr, f"¿Actualizar {ctr} de verdad? (y/n)"):
                            run_ext(stdscr, ["env", "DRY_RUN=0", f"CONFIRM_UPDATE={key}",
                                             UPDATE_SCRIPT, "service", key])
            elif k in (ord("m"), ord("M")):
                run_ext(stdscr, [os.path.join(STACK_SCRIPTS, "media-status.sh")])
            elif k in (ord("d"), ord("D")):
                run_ext(stdscr, [DOCKER, "ps", "-a", "--format",
                                 "table {{.Names}}\t{{.Status}}\t{{.Image}}"])
            elif k == curses.KEY_RESIZE:
                stdscr.erase()

if __name__ == "__main__":
    if not os.environ.get("TERM") or os.environ.get("TERM") == "dumb":
        os.environ["TERM"] = "linux"
    os.environ["ESCDELAY"] = "25"
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        print("chaetop cerrado (Ctrl+C).")
